#!/bin/bash
# mkinitcpio build hook: registers the 'abroot' runtime hook.

build() {
	add_module overlay
	add_runscript
}

help() {
	cat <<HELPEOF
This hook configures an AcreetionOS Immutable A/B boot:
  * selects the root slot from the abroot.slot= kernel parameter (default A)
  * mounts the shared data partition at /mnt/.data
  * overlays a persistent per-slot writable /etc on top of the read-only root
It must run after the 'filesystems' hook.
HELPEOF
}

